{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/alfahack/insight.schema.json",
  "title": "Insight v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "company_id",
    "title",
    "bank_status",
    "claims",
    "evidence",
    "missing_fields"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "bank_status": {
      "enum": [
        "found",
        "missing",
        "conflicting"
      ]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "text",
          "evidence_ids"
        ],
        "properties": {
          "kind": {
            "enum": [
              "fact",
              "bank_view",
              "ai_inference"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_id",
          "kind",
          "locator",
          "quote"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "company",
              "news",
              "bank"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
