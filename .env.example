# Только шаблон. Реальные значения не коммитить.
APP_ENV=development
LLM_MODE=mock
# Точные ID и URL выдаёт организатор. Пустой ID в API/local должен приводить к отказу.
LLM_MODEL_ID=
LLM_BASE_URL=
LLM_API_KEY=
LLM_DAILY_BUDGET_RUB=500
# Уточнить timezone сброса у провайдера; до этого не считать бюджет готовым.
LLM_BUDGET_RESET_TIMEZONE=
DATABASE_URL=
